# 复制为 .env 或直接设置环境变量。不配置也能跑（自动使用离线规则模式）。

# DeepSeek 示例
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
ZHIXI_LLM_MODEL=deepseek-chat

# 通义千问示例
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ZHIXI_LLM_MODEL=qwen-plus

# 演示用：让指定工具在首次调用时失败，用于展示"失败自动重试"分支
# ZHIXI_DEMO_FAIL_FIRST_CALL=retrieve_manual

# 可选：设置后应用会开启访问口令门；不设置则任何人打开链接即可使用
# ZHIXI_PASSWORD=your-password
